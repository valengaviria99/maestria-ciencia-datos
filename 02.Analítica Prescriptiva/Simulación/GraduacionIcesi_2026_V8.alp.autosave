						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[Persona p = (Persona) agent;

invitadosUbicados++;
personasUbicadas++;
p.horaUbicacion = time();

if (time() > horaInicioPlaneada) {
    invitadosTarde++;
}

if (p.visibleAnimacion) {

    int i = visualInvitadosUbicados;

    int columnas = 45;

    double xMin = 320;
    double xMax = 745;
    double yMin = 120;
    double yMax = 500;

    double dx = 9;
    double dy = 9;

    double x = xMin + (i % columnas) * dx;
    double y = yMin + (i / columnas) * dy;

    // Evitar que se salgan del auditorio
    x = max(xMin, min(x, xMax));
    y = max(yMin, min(y, yMax));

    p.setXY(x, y);

    visualInvitadosUbicados++;
}]]></Code>
							</Value>
