				<Control Type="Button">
				 	<EmbeddedIcon>false</EmbeddedIcon>				
					<Id>1782172038725</Id>
					<Name><![CDATA[button]]></Name>
					<X>935</X><Y>505</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D3D</DrawMode>
					<BasicProperties Width="90" Height="20">
                        <EmbeddedIcon>false</EmbeddedIcon>	
						<TextColor>-16777216</TextColor>
						<Enabled>true</Enabled>
						<EnableExpression><![CDATA[getBestIteration() > 0]]></EnableExpression>
						<ActionCode><![CDATA[String s = "";
s += "horaAperturaGraduados\t" + format( horaAperturaGraduados ) + "\n";
s += "horaAperturaInvitados\t" + format( horaAperturaInvitados ) + "\n";
s += "horaInicioPlaneada\t" + format( horaInicioPlaneada ) + "\n";
s += "totalGraduados\t" + format( totalGraduados ) + "\n";
s += "invitadosPorGraduado\t" + format( invitadosPorGraduado ) + "\n";
s += "totalInvitados\t" + format( totalInvitados ) + "\n";
s += "totalAsistentesEsperados\t" + format( totalAsistentesEsperados ) + "\n";
s += "capacidadGraduados\t" + format( capacidadGraduados ) + "\n";
s += "capacidadInvitados\t" + format( capacidadInvitados ) + "\n";
s += "porcentajeInicioCeremonia\t" + format( porcentajeInicioCeremonia ) + "\n";
s += "probProblemaQRGraduado\t" + format( probProblemaQRGraduado ) + "\n";
s += "probProblemaQRInvitado\t" + format( probProblemaQRInvitado ) + "\n";
s += "nValidadoresTotales\t" + format( getBestParamValue( _oqvar_nValidadoresTotales ) ) + "\n";
s += "nOrientadores\t" + format( getBestParamValue( _oqvar_nOrientadores ) ) + "\n";
s += "nSoporte\t" + format( getBestParamValue( _oqvar_nSoporte ) ) + "\n";

copyToClipboard( s );]]></ActionCode>
					</BasicProperties>
					<ExtendedProperties>
						<Font Name="Dialog" Size="11" Style="0"/>
						<LabelText><![CDATA[Copy best]]></LabelText>
					</ExtendedProperties>
