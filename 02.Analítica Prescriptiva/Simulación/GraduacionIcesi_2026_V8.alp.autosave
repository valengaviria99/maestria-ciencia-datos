			<Events>
				<Event>
					<Id>1781469238678</Id>
					<Name><![CDATA[evMedirFilas]]></Name>
					<X>520</X><Y>-880</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_MINUTE]]></Unit>
						</Rate>
						<Id>1781469238676</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1781510400000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[maxFilaGraduados = max(maxFilaGraduados, service.size() + service1.size() + service2.size()); 
maxFilaInvitados = max(maxFilaInvitados, service3.size() + service4.size() + service5.size()); 
 
int filaSoporteTotal = queueSoporteGrad.size() + queueSoporteInv.size(); 
maxFilaSoporte = max(maxFilaSoporte, filaSoporteTotal);]]></Action>
				</Event>
				<Event>
					<Id>1781469243854</Id>
					<Name><![CDATA[evCalcularCosto]]></Name>
					<X>520</X><Y>-800</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="occuresOnce">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_MINUTE]]></Unit>
						</Rate>
						<Id>1781469243852</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1781510400000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[300]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[MINUTE]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[if (!ceremoniaIniciada) { 
    retrasoInicioCeremonia = 999; 
} 
 
costoTotal = 
    retrasoInicioCeremonia * 100 
  + maxFilaGraduados * 3 
  + maxFilaInvitados * 2 
  + maxFilaSoporte * 5 
  + graduadosTarde * 80 
  + invitadosTarde * 30 
  + personasSinCupo * 100 
  + nValidadoresTotales * 10 
  + nOrientadores * 8 
  + nSoporte * 12;]]></Action>
				</Event>
